# Copy this file to .env.test and fill in real values.
# .env.test is gitignored — never commit credentials.

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Vercel Deployment Protection must be DISABLED for this URL, or use the
# production domain (e.g. https://your-app.vercel.app).
BASE_URL=https://your-app.vercel.app

# ── Backend API ───────────────────────────────────────────────────────────────
API_URL=https://your-backend.onrender.com

# ── Test account credentials ──────────────────────────────────────────────────
TEST_CUSTOMER_EMAIL=testcustomer@example.com
TEST_CUSTOMER_PASSWORD=Test@1234
TEST_CUSTOMER_PHONE=9999999901

TEST_CATERER_EMAIL=testcaterer@example.com
TEST_CATERER_PASSWORD=Test@1234

TEST_RIDER_EMAIL=testrider@example.com
TEST_RIDER_PASSWORD=Test@1234

TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=Admin@123
