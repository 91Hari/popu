PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=popu
DB_USER=popu
DB_PASSWORD=popu_secret
DB_POOL_MAX=10

JWT_SECRET=popu_jwt_super_secret_change_in_production
JWT_EXPIRES_IN=7d

CORS_ORIGIN=*

# SMS / OTP delivery via Fast2SMS (https://fast2sms.com → Dev API → API Key)
# Set this to send real OTPs to mobile numbers.
# Without this key, OTPs are only printed to the server console (development fallback).
FAST2SMS_API_KEY=

# OTP rate limit: max OTP requests per mobile number per hour (default: 10)
# Increase this during testing if you hit 429 errors.
# OTP_RATE_LIMIT=10
