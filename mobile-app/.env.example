# PO.PU Mobile App — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Backend API
EXPO_PUBLIC_API_URL=https://popu-backend.onrender.com

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAWZeG4kA12ZEwWyLrLsI750QItyyNGi90

# Firebase (for push notifications)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# App
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_PACKAGE_NAME=com.popu.app
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://popu.co.in/privacy
EXPO_PUBLIC_TERMS_URL=https://popu.co.in/terms
